{
  "name": "testpilot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TestPilot 智测领航前端（Vue 3 + TypeScript + Element Plus + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test src/features/authoring/model.test.js src/features/runs/composables/analysisRequestStore.test.mjs src/features/runs/runContext.test.mjs",
    "test:analysis": "node --test src/features/runs/composables/analysisRequestStore.test.mjs",
    "test:runs": "node --test src/features/runs/runContext.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.8.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
